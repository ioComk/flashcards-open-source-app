VITE_API_BASE_URL=http://localhost:8080/v1
VITE_AUTH_BASE_URL=http://localhost:8081
VITE_APP_BASE_URL=http://localhost:3000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_APP_BUILD=

# Vercel UI clone (set these in the Vercel project Environment Variables).
# Official API/auth hosts reject non-allowlisted browser origins, so login and
# sync from a Vercel URL will not work against the reference deployment.
# VITE_API_BASE_URL=https://api.flashcards-open-source-app.com/v1
# VITE_AUTH_BASE_URL=https://auth.flashcards-open-source-app.com
# VITE_APP_BASE_URL=https://your-app.vercel.app
# VITE_SENTRY_ENVIRONMENT=production

